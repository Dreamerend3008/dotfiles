
# Remove the OS title bar for a seamless, floating app look
# window-decoration = false

# Window default size
window-width = 140
window-height = 40

# Transparency
background-opacity = 0.9

# Add generous padding so text doesn't touch the glass (crucial for the modern look)
window-padding-x = 10
window-padding-y = 10

# Theme
theme = dark:Catppuccin Mocha
#light:Catppuccin Latte 

# keybindings
keybind = performable:ctrl+h=goto_split:left
keybind = performable:ctrl+j=goto_split:down
keybind = performable:ctrl+k=goto_split:up
keybind = performable:ctrl+l=goto_split:right

